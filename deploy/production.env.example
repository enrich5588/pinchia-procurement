# Literal values: no shell expansion and no surrounding quotes.
# Copy to /srv/pinjia/shared/production.env; chmod 600.
DJANGO_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_50_CHARACTERS
DJANGO_ALLOWED_HOSTS=procurement.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://procurement.example.com
FEATURE_OPEN_TO_ALL=true
M365_TENANT_ID=
M365_CLIENT_ID=
M365_REDIRECT_URI=https://procurement.example.com/accounts/microsoft/callback/
# Certificate files go in shared/secrets; choose certificate OR client secret.
M365_CERT_PRIVATE_KEY_PATH=
M365_CERT_THUMBPRINT=
M365_CLIENT_SECRET=
M365_ALLOW_GUESTS=false
M365_DEFAULT_ADMIN_UPN=tonychi@pin-chia.com
ALLOW_LOCAL_LOGIN=false
