# Copy to .env for local development. Values are literal; no expansion.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
FEATURE_OPEN_TO_ALL=true
# Optional: use an absolute path for a different database or private files.
# DJANGO_DB_PATH=D:/data/pinjia/db.sqlite3
# DJANGO_MEDIA_ROOT=D:/data/pinjia/private-media
# Production only: set these in the deployment process environment.
# DJANGO_SETTINGS_MODULE=config.settings.production
# DJANGO_SECRET_KEY=replace-with-a-unique-random-secret-of-at-least-50-characters
# DJANGO_CSRF_TRUSTED_ORIGINS=https://procurement.example.com

# Company Microsoft 365 sign-in. Register a single-tenant Web application.
# Credentials are server-side only; never put them in templates or Git.
M365_TENANT_ID=
M365_CLIENT_ID=
# Exact registered URI. Local development uses localhost, not 127.0.0.1.
M365_REDIRECT_URI=
# Choose ONE credential type. Certificate is recommended for production.
M365_CERT_PRIVATE_KEY_PATH=
M365_CERT_THUMBPRINT=
# Client secret VALUE (not Secret ID), for environments using a secret.
M365_CLIENT_SECRET=
M365_ALLOW_GUESTS=false
# Explicit development/recovery opt-in; default is Microsoft-only everywhere.
ALLOW_LOCAL_LOGIN=false
# Only behind a trusted HTTPS proxy that overwrites X-Forwarded-Proto.
DJANGO_TRUST_PROXY_HTTPS=false
